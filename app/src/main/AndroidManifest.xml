<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No INTERNET permission, deliberately and permanently for v1. This app is fully
      offline: MediaStore in, Room out. See CLAUDE.md.
    -->

    <!-- minSdk is 33, so the granular media permissions always exist and there is no
         READ_EXTERNAL_STORAGE branch anywhere in the codebase. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Android 14+: the user may grant access to a hand-picked subset instead. This is
         a fully supported state, not an error. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!--
      Reading where a photo was taken. MediaStore redacts GPS from the copy it hands out
      unless this is granted AND the app asks for the original file explicitly; without it
      every photo simply has no location, which is a supported state rather than an error.
      Still no INTERNET: nothing about a coordinate leaves the device, and there is no
      reverse geocoding, because that would need the network.
    -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- Progress notification for the indexing worker. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GalleryOrganizerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GalleryOrganizer">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.GalleryOrganizer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
